# Public values embedded in the Expo app. Never put private API keys or client
# secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
EXPO_PUBLIC_REALTIME_URL=ws://localhost:8000/realtime
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Add this after linking the app to an Expo/EAS project. It enables Expo push
# token registration in local development when project metadata is unavailable.
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
